{
  "name": "agent-remplissage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agent de remplissage des formulaires assureurs — extension Chrome MV3",
  "scripts": {
    "architecture": "node outils/verifier-architecture.mjs",
    "types": "tsc --noEmit",
    "test": "node --test \"tests/**/*.test.ts\"",
    "build": "node outils/construire.mjs",
    "verifier": "npm run architecture && npm run types && npm run test",
    "essai": "esbuild essai/essai.ts essai/ontologie.ts --bundle --outdir=essai --format=iife --target=chrome120"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.13.3",
    "esbuild": "^0.24.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.6.0"
  }
}
